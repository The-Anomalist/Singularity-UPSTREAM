&gmu {
	interconnects = <&kona_icc KONA_ICC_GMU_TO_LLCC>,
			<&kona_icc KONA_ICC_GMU_TO_MEM>;
	interconnect-names = "gmu-llcc", "gmu-ddr";
	qcom,gmu-freq = <575000000>;
	qcom,gmu-icc-bw-avg-kbps = <1 292968 585937 878906>;
	qcom,gmu-icc-bw-peak-kbps = <1 1171875 2343750 3515625>;
};

&gpubw {
	/*
	 * V2 bins can sustain higher clocks than base A650, but keep the
	 * floor below top DDR/LLCC corners so light GPU work and UI
	 * composition are not pinned at gaming bandwidth all day.
	 */
	qcom,icc-no-split-ab-kbps;
	qcom,icc-boost-percent = <160>;
	qcom,polling-ms = <6>;
	qcom,icc-upscale-percent = <260>;
	qcom,icc-min-avg-kbps = <3515625>;
	qcom,icc-min-peak-kbps = <14062500>;
};
